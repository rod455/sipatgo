# ---------------------------------------------------------------
# Banco (obrigatório). Conexão Postgres direta — use o pooler do
# Supabase em modo "transaction" (porta 6543) em produção/Vercel.
# Todas as tabelas ficam no schema `sipatgo`, isolado do resto do banco.
# ---------------------------------------------------------------
DATABASE_URL=postgresql://postgres:senha@db.xxxxx.supabase.co:6543/postgres

# Segredo para assinar a sessão (cookie). Gere com: openssl rand -base64 48
SESSION_SECRET=

# ---------------------------------------------------------------
# Supabase (opcional, mas recomendado): Storage para imagens do mural,
# logos, materiais e PDFs; Realtime (broadcast) para ranking ao vivo.
# Sem isso, uploads ficam indisponíveis e o ranking atualiza por polling.
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prefixo dos buckets, para não colidir com buckets de outro produto
SUPABASE_BUCKET_PREFIX=sipatgo

# Webhook n8n global (cada company pode sobrescrever no painel)
NOTIFICATIONS_WEBHOOK_URL=

# Opcional: duração automática dos vídeos via YouTube Data API
YOUTUBE_API_KEY=

# HMAC dos QR codes de check-in
CHECKIN_HMAC_SECRET=

# URL pública (sem barra final). Ex.: https://sipatgo.com.br
APP_BASE_URL=http://localhost:3000
# Domínio raiz para subdomínio por cliente ({slug}.sipatgo.com.br)
ROOT_DOMAIN=sipatgo.com.br

# Protege /api/cron/* (Vercel Cron envia "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# Somente QA/dev: congela o relógio da aplicação (ISO 8601).
# Ignorado quando NODE_ENV=production, a menos que ALLOW_FAKE_NOW=1.
FAKE_NOW=
ALLOW_FAKE_NOW=

# ---------------------------------------------------------------
# Site público (sipatgo.com.br)
# ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://sipatgo.com.br
# Webhook n8n para leads do site (fallback: NOTIFICATIONS_WEBHOOK_URL)
LEADS_WEBHOOK_URL=
# WhatsApp comercial, só dígitos (ex.: 5511999999999). Vazio = botão oculto
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Google Analytics 4 (opcional)
NEXT_PUBLIC_GA_ID=
